SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=your-production-database-url
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Mailjet transactional email
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=your-verified-sender@example.com
MAILJET_FROM_NAME=Merco
MERCO_PUBLIC_URL=https://your-merco-domain.onrender.com

# Optional protected email queue endpoint
CRON_SECRET=replace-with-a-random-secret

# Demo marketplace seed: set to 1 on Render to keep 50 demo sellers/products available.
MERCO_SEED_DEMO_DATA=1
