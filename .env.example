SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=your-production-database-url
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# EmailJS transactional email settings
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_optional
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_VERIFICATION_TEMPLATE_ID=template_xxxxxxx_optional
EMAILJS_NOTIFICATION_TEMPLATE_ID=template_xxxxxxx_optional
EMAILJS_PRODUCT_TEMPLATE_ID=template_xxxxxxx_optional
MERCO_PUBLIC_URL=https://your-merco-domain.onrender.com

# Web Push / PWA phone notifications
# Generate a VAPID key pair once and keep the private key secret.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIMS_EMAIL=mailto:admin@your-domain.com
