{% extends "base.html" %}
{% block title %}Seller Hub | Maximise{% endblock %}
{% block content %}
<div class="container">
    <section class="hero"><div><div class="eyebrow">Seller workspace</div><h1>Your <span>storefront.</span></h1><p>Manage your listings and keep your marketplace presence fresh.</p></div><div class="hero-panel"><div><small>Active listings</small><div class="metric">{{ products|length }}</div></div><a href="{{ url_for('add_product') }}" class="btn"><i class="ri-add-line"></i> Add Product</a></div></section>
    <div class="section-heading"><div><h2>Your products</h2><p>Everything you currently have listed</p></div><a href="{{ url_for('add_product') }}" class="btn">New Listing</a></div>
    {% if products %}<div class="product-grid">{% for product in products %}<article class="product-card"><div class="product-media"><img src="{{ product.cover_image }}" alt="{{ product.name }}" loading="lazy"></div><div class="product-body"><h3>{{ product.name }}</h3><p class="price">₦{{ "{:,.2f}".format(product.price) }}</p><div class="product-actions"><a href="{{ url_for('product_detail', id=product.id) }}" class="btn full">View Listing <i class="ri-arrow-right-line"></i></a></div></div></article>{% endfor %}</div>{% else %}<div class="empty-state"><i class="ri-store-2-line"></i><strong>Your store is empty</strong><p>Add your first product to get started.</p></div>{% endif %}
</div>
{% endblock %}
